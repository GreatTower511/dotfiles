# delta を git の pager として使う設定
# ~/.gitconfig から [include] で読み込む

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	syntax-theme = Nord
	dark = true
	file-style = bold yellow ul
	file-decoration-style = none
	hunk-header-style = file line-number syntax
	plus-style = "syntax #1e3a2f"
	minus-style = "syntax #3a1e1e"
	line-numbers-left-style = "blue dim"
	line-numbers-right-style = "blue dim"

[add "diff"]
	# side-by-sideをトグルするエイリアス
